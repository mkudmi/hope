# Local development. Copy to .env, generate keys with scripts/init_env.py.
DEBUG=true
DJANGO_SECRET_KEY=
DATA_ENCRYPTION_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
# Production on the panel's domain: https://vpn.example.com/hope
# The path in SITE_URL defines the app prefix; proxy strips it before forwarding.
TRUST_PROXY_HTTPS=false
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Add your token here. BOT_USERNAME is the actual username assigned in BotFather.
BOT_USERNAME=hopevpn
BOT_TOKEN=
ADMIN_GROUP_CHAT_ID=
ADMIN_CHAT_ID=

# demo never contacts real VPN servers. Switch to real for API integration.
PANEL_MODE=demo
PANEL_URL=
PANEL_API_TOKEN=
PANEL_SUB_URL=
PANEL_WRITES_ENABLED=false
PANEL_INBOUND_IDS=3,4,5,6,7,8,10,11,12,13
# Explicitly list all gateway/service/test clients before importing real panel.
PANEL_EXCLUDED_CLIENTS=

# Empty = native SQLite for local use; Docker overrides with its own PostgreSQL.
DATABASE_URL=
APP_DATABASE_NAME=hope
LOCAL_DB_PASSWORD=
LOCAL_ADMIN_LOGIN=admin
LOCAL_ADMIN_PASSWORD=
LOCAL_DEMO_LOGIN=demo
LOCAL_DEMO_PASSWORD=
SUPPORT_CONTACT=Обратитесь через форму поддержки в кабинете.
RENEWAL_INSTRUCTIONS=Согласуйте стоимость и перевод с администратором. Продление выполняется вручную.

# Approved by owner: enable the catalog explicitly. Requisites are sent personally.
TARIFFS_APPROVED=false
TARIFF_WEEK_PRICE=99
TARIFF_MONTH_PRICE=299
TARIFF_QUARTER_PRICE=799
TARIFF_HALFYEAR_PRICE=1499
TARIFF_YEAR_PRICE=2799
