# HOPE VPN: один файл настроек для бота, веб-кабинета, worker и локального Docker.
# Для нового окружения: uv run python scripts/init_env.py (создаст .env и ключи).
# .env хранить с правами 0600; не отправлять в Git и не выполнять через source.
# Одно значение на строку. true/false для флагов, списки через запятую без пробелов.

# === Приложение и безопасность ===
# true — локальная разработка; публичный запуск требует false, PostgreSQL и HTTPS.
DEBUG=true
# Генерируются init_env.py. DATA_ENCRYPTION_KEY нельзя менять без миграции данных.
DJANGO_SECRET_KEY=
DATA_ENCRYPTION_KEY=
# Разрешённые имена хостов, без схемы/пути.
ALLOWED_HOSTS=localhost,127.0.0.1
# Публичный адрес кабинета. При размещении на домене панели: https://vpn.example.com/hope
# Путь в SITE_URL автоматически применяется к страницам, static и cookies.
SITE_URL=http://127.0.0.1:8000
# Для публичного HTTPS поставить true; локально HTTP — false.
SECURE_SSL_REDIRECT=false
# Только за доверенным proxy, который сам перезаписывает X-Forwarded-Proto.
TRUST_PROXY_HTTPS=false
# Разрешённые origins для POST: схема и хост, без /hope/.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# === Telegram ===
# Фактическое имя BotFather, без @. Профиль Docker telegram запускает polling.
BOT_USERNAME=hopevpn
BOT_TOKEN=
# ID административной группы, обычно отрицательный. Бот должен иметь право писать.
ADMIN_GROUP_CHAT_ID=
# Запасной адрес административных событий; допустим ID группы или личного чата.
ADMIN_CHAT_ID=

# === Интеграция 3x-ui ===
# demo — имитация; real — действующая панель. Локальный запуск не делает панель тестовой.
PANEL_MODE=demo
# HTTPS адрес панели с её базовым путём. Не путать с адресом выдачи подписок.
PANEL_URL=
PANEL_API_TOKEN=
# HTTPS базовый адрес подписок, к нему приложение добавляет subId клиента.
PANEL_SUB_URL=
# Сохранять false для действующей панели до отдельного разрешения на запись.
PANEL_WRITES_ENABLED=false
# Inbound ID для нового доступа; существующие привязки импортируются из панели.
PANEL_INBOUND_IDS=3,4,5,6,7,8,10,11,12,13
# Точные panel_email служебных/тестовых клиентов, которые не импортировать.
PANEL_EXCLUDED_CLIENTS=

# === База данных ===
# Native: пусто — отдельная SQLite data/hope.sqlite3; URL — postgres://user:password@host:port/db
# Docker сам задаёт DATABASE_URL из LOCAL_DB_PASSWORD и APP_DATABASE_NAME (приоритет над этой строкой).
DATABASE_URL=
# Только собственная база HOPE в Docker; не база действующей панели.
APP_DATABASE_NAME=hope
LOCAL_DB_PASSWORD=

# === Первоначальные локальные аккаунты ===
# bootstrap_owner создаёт отсутствующего владельца; смена значения не меняет пароль существующего.
LOCAL_ADMIN_LOGIN=admin
LOCAL_ADMIN_PASSWORD=
# Используются только demo bootstrap/browser smoke, не для реальных клиентов.
LOCAL_DEMO_LOGIN=demo
LOCAL_DEMO_PASSWORD=

# === Поддержка и ручное продление ===
SUPPORT_CONTACT=Обратитесь через форму поддержки в кабинете.
RENEWAL_INSTRUCTIONS=Согласуйте стоимость и перевод с администратором. Продление выполняется вручную.
# Реквизиты администратор присылает лично. Платёжной автоматизации нет.

# === Каталог тарифов ===
# Включить после утверждения владельцем. Цены — целые положительные рубли за весь срок.
TARIFFS_APPROVED=false
TARIFF_WEEK_PRICE=99
TARIFF_MONTH_PRICE=299
TARIFF_QUARTER_PRICE=799
TARIFF_HALFYEAR_PRICE=1499
TARIFF_YEAR_PRICE=2799

# === Изолированные проверки разработчика ===
# Только demo+DEBUG. Не запускать browser smoke против действующей real-интеграции.
BROWSER_BASE_URL=http://127.0.0.1:8001

# === Серверная раскатка (deploy/compose.server.yaml) ===
# Устанавливаются deploy-server.sh; для локальной проверки можно переопределить.
HOPE_IMAGE=hope-cz:local-check
HOPE_ENV_FILE=/opt/hope/shared/.env
